---
import { getEntry, render } from 'astro:content';
import EntityLayout from '@/layouts/EntityLayout.astro';
import Card from '@/components/Card.astro';
import Related from '@/components/Related.astro';
import MediaSection from '@/components/media/MediaSection.astro';
import TombExplorer from '@/components/media/TombExplorer.astro';
import EvidenceKey from '@/components/media/EvidenceKey.astro';
import ReconstructionSources from '@/components/media/ReconstructionSources.astro';
import { isRoom } from '@/lib/plans';
import VideoFeature from '@/components/media/VideoFeature.astro';
import { getArtifacts, getTombs, videosAbout } from '@/lib/content';
import { cards } from '@/lib/cards';
import { ordinal } from '@/lib/format';
import { GLYPHS } from '@/lib/site';
import { VALLEYS } from '@/lib/tombs';

export async function getStaticPaths() {
  return (await getTombs()).map((tomb) => ({ params: { slug: tomb.id }, props: { tomb } }));
}

const { tomb } = Astro.props;
const t = tomb.data;
const pharaoh = t.pharaoh && (await getEntry(t.pharaoh));
const plan = t.media.plan && (await getEntry(t.media.plan))?.data;
const artifacts = (await getArtifacts()).filter((a) => a.data.tomb?.id === tomb.id);
const videos = await videosAbout('tombs', tomb.id);
const featured = t.media.video ? await getEntry(t.media.video.ref) : videos.find((v) => v.data.youtubeId);
const otherVideos = videos.filter((v) => v.id !== featured?.id);
const neighbours = (await getTombs()).filter((o) => o.id !== tomb.id && t.valley && o.data.valley === t.valley);
const { Content } = await render(tomb);
const title = t.code ? `${t.code}: ${t.name}` : t.name;
const sarcophagus = plan?.spaces.find((s) => s.sarcophagus)?.sarcophagus;
---

<EntityLayout
  title={title}
  description={t.description}
  kicker={`Tomb · ${ordinal(Number(t.dynasty.id))} Dynasty${t.valley ? ` · ${VALLEYS[t.valley].name}` : ''}`}
  lede={t.site}
  glyph={GLYPHS.tombs}
  media={t.media}
  mapFocus={t.coordinates ? `tombs/${tomb.id}` : undefined}
  crumbs={[
    { label: 'Tombs', href: '/tombs/' },
    { label: t.code ?? t.name, href: `/tombs/${tomb.id}/` },
  ]}
  facts={[
    t.code && { label: 'Tomb number', value: t.code },
    { label: 'Owner', value: t.owner },
    { label: 'Dynasty', value: `${ordinal(Number(t.dynasty.id))} Dynasty`, href: `/dynasties/${t.dynasty.id}/` },
    { label: 'Location', value: t.site },
    t.discovered && { label: 'Discovered', value: `${t.discovered.year} by ${t.discovered.by}` },
    !!plan?.length && { label: 'Length', value: `c. ${Math.round(plan.length)} m` },
    !!plan?.area && { label: 'Floor area', value: `c. ${Math.round(plan.area)} m²` },
    plan && { label: 'Spaces', value: `${plan.spaces.filter(isRoom).length} (see the plan below)`, href: '#inside' },
    sarcophagus && { label: 'Sarcophagus', value: sarcophagus.label },
  ]}
  jsonLd={[
    {
      '@type': 'LandmarksOrHistoricalBuildings',
      name: t.name,
      alternateName: t.code,
      description: t.description,
      url: new URL(`/tombs/${tomb.id}/`, Astro.site).href,
      ...(t.coordinates && {
        geo: { '@type': 'GeoCoordinates', latitude: t.coordinates[0], longitude: t.coordinates[1] },
      }),
      ...(t.valley && { containedInPlace: { '@type': 'Place', name: VALLEYS[t.valley].name } }),
    },
  ]}
>
  <Content />

  <Fragment slot="explore">
    {plan && (
      <MediaSection
        id="inside"
        kicker="Inside the tomb"
        title="Explore the chambers"
        lede="Follow the tomb from its entrance to the burial chamber. Select a space in the list, the plan or the 3D model."
      >
        <TombExplorer plan={plan} model={t.media.model} name={title} />
        <div class="key"><EvidenceKey compact /></div>
        <ReconstructionSources plan={plan} />
      </MediaSection>
    )}
    {featured && (
      <MediaSection kicker="NeoKemet on YouTube" title="Watch">
        <VideoFeature video={featured} start={t.media.video?.start} note={t.media.video?.note} />
      </MediaSection>
    )}
  </Fragment>

  <Fragment slot="related">
    <Related title="Pharaoh" count={pharaoh ? 1 : 0}>
      {pharaoh && <Card {...cards.pharaoh(pharaoh)} />}
    </Related>
    <Related title="Found in this tomb" count={artifacts.length}>
      {artifacts.map((a) => <Card {...cards.artifact(a)} />)}
    </Related>
    <Related title="More films" count={otherVideos.length}>
      {otherVideos.map((v) => <Card {...cards.video(v)} />)}
    </Related>
    <Related title={t.valley ? `More in the ${VALLEYS[t.valley].name}` : 'More tombs'} count={neighbours.length}>
      {neighbours.map((o) => <Card {...cards.tomb(o)} />)}
    </Related>
  </Fragment>
</EntityLayout>

<style>
  .key { margin-top: 1.5rem; }
</style>
