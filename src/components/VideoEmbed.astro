---
/**
 * Privacy-friendly, lightweight YouTube embed. Shows a thumbnail (local image
 * or YouTube's own, lazy-loaded) with title and duration, and only loads the
 * player from youtube-nocookie.com after a click. Without an ID it renders a
 * "coming soon" poster.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { formatDuration } from '@/lib/format';
import { youtubeThumb } from '@/lib/media';
import { YOUTUBE } from '@/lib/site';

export interface Props {
  youtubeId?: string;
  title: string;
  duration?: string;
  thumbnail?: ImageMetadata;
  /** Show the title bar over the thumbnail. */
  overlay?: boolean;
  priority?: boolean;
  /** Start playback here, in seconds (e.g. at a chapter). */
  start?: number;
}
const { youtubeId, title, duration, thumbnail, overlay = true, priority = false, start } = Astro.props;
const length = formatDuration(duration);
const thumb = youtubeId && youtubeThumb(youtubeId);
---

{youtubeId || thumbnail ? (
  <div class="video" data-youtube-id={youtubeId} data-title={title} data-start={start}>
    {thumbnail ? (
      <Picture src={thumbnail} alt="" formats={['avif', 'webp']} widths={[480, 960, 1440]} sizes="(min-width: 60rem) 60rem, 100vw" loading={priority ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      thumb && <img src={thumb.large} srcset={thumb.srcset} sizes="(min-width: 60rem) 60rem, 100vw" alt="" width="1280" height="720" loading={priority ? 'eager' : 'lazy'} decoding="async" />
    )}
    {overlay && (
      <div class="meta">
        <span class="title">{title}</span>
      </div>
    )}
    {length && <span class="duration">{length}</span>}
    {youtubeId ? (
      <a class="play" href={`https://www.youtube.com/watch?v=${youtubeId}${start ? `&t=${start}s` : ''}`}>
        <span class="play-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Play video: {title}</span>
      </a>
    ) : (
      <div class="soon-badge">In production · <a href={YOUTUBE.subscribeUrl} rel="noopener">Subscribe to be notified</a></div>
    )}
  </div>
) : (
  <div class="video video--soon">
    <span class="soon-glyph" aria-hidden="true">𓂀</span>
    <p class="soon-label">In production</p>
    <p>This film is being made for the NeoKemet channel.</p>
    <a class="btn btn--ghost" href={YOUTUBE.subscribeUrl} rel="noopener">Subscribe to be notified</a>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('.video[data-youtube-id]').forEach((el) => {
    if (!el.dataset.youtubeId) return;
    el.querySelector('.play')?.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      const start = el.dataset.start ? `&start=${el.dataset.start}` : '';
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.youtubeId}?autoplay=1&rel=0${start}`;
      iframe.title = el.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow);
  }
  .video img, .video :global(picture), .video :global(img), .video :global(iframe) { width: 100%; height: 100%; object-fit: cover; border: 0; display: block; }
  .meta {
    position: absolute; inset: 0 0 auto 0;
    padding: 1rem 1.2rem 2.5rem;
    background: linear-gradient(rgb(0 0 0 / 0.75), transparent);
    pointer-events: none;
  }
  .title { font-family: var(--font-display); font-size: clamp(0.9rem, 0.8rem + 0.5vw, 1.15rem); color: #fff; text-shadow: 0 1px 6px rgb(0 0 0 / 0.8); }
  .duration {
    position: absolute; right: 0.7rem; bottom: 0.7rem;
    padding: 0.15rem 0.5rem; border-radius: 3px;
    background: rgb(0 0 0 / 0.8); color: #fff; font-size: 0.8rem; font-weight: 600; font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .play { position: absolute; inset: 0; display: grid; place-items: center; background: rgb(0 0 0 / 0.15); transition: background 0.3s var(--ease); }
  .play:hover { background: rgb(0 0 0 / 0); }
  .play-icon {
    width: 5rem; height: 5rem;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: rgb(11 10 8 / 0.7);
    box-shadow: var(--glow);
    position: relative;
    transition: transform 0.3s var(--ease);
  }
  .play:hover .play-icon { transform: scale(1.08); }
  .play-icon::after {
    content: '';
    position: absolute;
    left: 54%; top: 50%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 0.8rem 0 0.8rem 1.3rem;
    border-color: transparent transparent transparent var(--gold);
  }
  .soon-badge {
    position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%);
    padding: 0.4rem 0.9rem; border-radius: 999px; white-space: nowrap;
    background: rgb(11 10 8 / 0.8); border: 1px solid var(--line-strong);
    font-size: 0.8rem; color: var(--text-muted);
  }
  .video--soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 1.5rem;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 40%, rgb(200 149 43 / 0.16), transparent 60%),
      linear-gradient(180deg, #17140f, #0b0a08);
  }
  .video--soon p { margin: 0; color: var(--text-muted); }
  .soon-glyph { font-family: var(--font-glyph); font-size: 3.5rem; line-height: 1; color: var(--gold); }
  .soon-label { font-family: var(--font-display); letter-spacing: 0.25em; text-transform: uppercase; color: var(--limestone) !important; }
  .video--soon .btn { margin-top: 0.8rem; }
</style>
