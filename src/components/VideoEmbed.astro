---
/**
 * Privacy-friendly, lightweight YouTube embed: shows the thumbnail and only
 * loads the YouTube player (from youtube-nocookie.com) after a click.
 * Without an ID it renders a "coming soon" poster.
 */
import { YOUTUBE } from '@/lib/site';

export interface Props { youtubeId?: string; title: string }
const { youtubeId, title } = Astro.props;
---

{youtubeId ? (
  <div class="video" data-youtube-id={youtubeId} data-title={title}>
    <img
      src={`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    <a class="play" href={`https://www.youtube.com/watch?v=${youtubeId}`}>
      <span class="play-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Play video: {title}</span>
    </a>
  </div>
) : (
  <div class="video video--soon">
    <span class="soon-glyph" aria-hidden="true">𓂀</span>
    <p class="soon-label">In production</p>
    <p>This film is being made for the NeoKemet channel.</p>
    <a class="btn btn--ghost" href={YOUTUBE.subscribeUrl} rel="noopener">Subscribe to be notified</a>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('.video[data-youtube-id]').forEach((el) => {
    el.querySelector('.play')?.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.youtubeId}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    box-shadow: var(--shadow);
  }
  .video img, .video :global(iframe) { width: 100%; height: 100%; object-fit: cover; border: 0; }
  .play { position: absolute; inset: 0; display: grid; place-items: center; background: rgb(0 0 0 / 0.25); transition: background 0.3s var(--ease); }
  .play:hover { background: rgb(0 0 0 / 0.1); }
  .play-icon {
    width: 5rem; height: 5rem;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background: rgb(11 10 8 / 0.7);
    box-shadow: var(--glow);
    position: relative;
  }
  .play-icon::after {
    content: '';
    position: absolute;
    left: 54%; top: 50%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 0.8rem 0 0.8rem 1.3rem;
    border-color: transparent transparent transparent var(--gold);
  }
  .video--soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 1.5rem;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 40%, rgb(200 149 43 / 0.16), transparent 60%),
      linear-gradient(180deg, #17140f, #0b0a08);
  }
  .video--soon p { margin: 0; color: var(--text-muted); }
  .soon-glyph { font-family: var(--font-glyph); font-size: 3.5rem; line-height: 1; color: var(--gold); }
  .soon-label { font-family: var(--font-display); letter-spacing: 0.25em; text-transform: uppercase; color: var(--limestone) !important; }
  .video--soon .btn { margin-top: 0.8rem; }
</style>
