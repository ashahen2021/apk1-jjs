---
/**
 * Interactive 3D model using Google's <model-viewer>. The page ships only a
 * poster image; the viewer (~1 MB with three.js) and the GLB load when the
 * visitor asks for them, so there is no cost to page speed.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { creditLine, widthsFor, type MediaKind } from '@/lib/media';

export interface Props {
  src: string;
  poster: ImageMetadata;
  alt: string;
  caption?: string;
  ar?: boolean;
  cameraOrbit?: string;
  credit?: string;
  kind?: MediaKind;
  license?: string;
}
const { src, poster, alt, caption, ar = true, cameraOrbit, ...rest } = Astro.props;
const credit = creditLine(rest);
---

<figure class="model" data-model data-src={src} data-alt={alt} data-ar={String(ar)} data-orbit={cameraOrbit ?? ''}>
  <div class="stage" data-stage>
    <Picture class="poster" src={poster} alt={alt} formats={['avif', 'webp']} widths={widthsFor(poster, [640, 1000, 1600])} sizes="(min-width: 76rem) 70rem, 100vw" loading="lazy" decoding="async" />
    <button type="button" class="load" data-load>
      <span class="cube" aria-hidden="true"></span>
      <span>Explore in 3D</span>
      <small>Drag to rotate · pinch to zoom{ar && ' · view in AR on supported phones'}</small>
    </button>
    <p class="status" data-status hidden>Loading 3D viewer…</p>
  </div>
  {(caption || credit) && <figcaption>{caption}{credit && <span>{credit}</span>}</figcaption>}
  <noscript><p class="noscript">Enable JavaScript to explore this model in 3D, or <a href={src}>download the GLB file</a>.</p></noscript>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-model]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-load]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    button.addEventListener('click', async () => {
      button.hidden = true;
      status.hidden = false;
      try {
        await import('@google/model-viewer');
        const d = root.dataset;
        const mv = document.createElement('model-viewer') as HTMLElement & { loaded?: boolean };
        const attrs: Record<string, string> = {
          src: d.src!,
          alt: d.alt!,
          'camera-controls': '',
          'touch-action': 'pan-y',
          'shadow-intensity': '1.3',
          'shadow-softness': '0.8',
          exposure: '0.8',
          'tone-mapping': 'aces',
          'environment-image': 'neutral',
          'interaction-prompt': 'auto',
          loading: 'eager',
        };
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          attrs['auto-rotate'] = '';
          attrs['auto-rotate-delay'] = '1500';
          attrs['rotation-per-second'] = '12deg';
        }
        if (d.orbit) attrs['camera-orbit'] = d.orbit;
        if (d.ar === 'true') {
          attrs.ar = '';
          attrs['ar-modes'] = 'webxr scene-viewer quick-look';
        }
        for (const [k, v] of Object.entries(attrs)) mv.setAttribute(k, v);
        mv.addEventListener('load', () => {
          status.hidden = true;
          stage.classList.add('is-live');
        });
        mv.addEventListener('error', () => (status.textContent = 'The 3D model could not be loaded.'));
        stage.append(mv);
      } catch {
        status.textContent = 'The 3D viewer could not be loaded.';
      }
    });
  });
</script>

<style>
  .model { margin: 0; }
  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: radial-gradient(ellipse at 50% 35%, #2b2419, #0d0b08 70%);
  }
  .stage :global(.poster), .stage :global(.poster img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .stage.is-live :global(.poster) { opacity: 0; transition: opacity 0.6s var(--ease); }
  .stage :global(model-viewer) { position: absolute; inset: 0; width: 100%; height: 100%; --poster-color: transparent; --progress-bar-color: var(--gold); }
  .load {
    position: absolute; left: 50%; bottom: 1.25rem; transform: translateX(-50%);
    display: grid; justify-items: center; gap: 0.15rem;
    padding: 0.8rem 1.4rem;
    border: 1px solid var(--gold); border-radius: var(--radius);
    background: rgb(11 10 8 / 0.82); backdrop-filter: blur(6px);
    color: var(--limestone); font-family: var(--font-display); letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.85rem;
    cursor: pointer;
    transition: box-shadow 0.3s var(--ease);
  }
  .load:hover { box-shadow: var(--glow); }
  .load small { font-family: var(--font-body); text-transform: none; letter-spacing: 0.02em; color: var(--text-muted); font-size: 0.72rem; }
  .cube { width: 1.4rem; height: 1.4rem; border: 1.5px solid var(--gold); transform: rotate(45deg) skew(8deg, 8deg); margin-bottom: 0.3rem; }
  .status { position: absolute; left: 50%; bottom: 1.5rem; transform: translateX(-50%); margin: 0; padding: 0.4rem 0.9rem; border-radius: 999px; background: rgb(11 10 8 / 0.8); color: var(--text-muted); font-size: 0.85rem; }
  figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.3rem 1rem; margin-top: 0.6rem; font-size: var(--step--1); color: var(--text-muted); }
  figcaption span { color: var(--text-faint); font-size: 0.75rem; }
  .noscript { font-size: var(--step--1); color: var(--text-muted); }
</style>
