---
/**
 * The tomb explorer: an interactive 3D cut-away (lazy-loaded <model-viewer>
 * with chamber, wall-scene and feature hotspots), the plan and a depth
 * profile, all drawn from the same plan data. A chamber list, detail panels,
 * view toggles and a guided tour stay in sync across the three views.
 *
 * Everything except the 3D view is HTML/SVG in the page, so it is crawlable
 * and usable without JavaScript or WebGL.
 */
import { statSync } from 'node:fs';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TombPlan from './TombPlan.astro';
import {
  CONDITION_LABEL, KIND_LABEL, STATUS_HELP, STATUS_LABEL, STATUS_LONG, depthText, dimensions, features, hotspots, overview, tour, type Plan,
} from '@/lib/plans';

export interface Props {
  plan: Plan;
  model?: { src: string; poster: ImageMetadata; alt: string; caption?: string; ar?: boolean };
  name: string;
}
const { plan, model, name } = Astro.props;

const spots = hotspots(plan);
const stops = tour(plan);
const full = overview(plan);
const hasScenes = plan.spaces.some((s) => s.scenes.length);
const burial = plan.route.at(-1) ?? plan.spaces[0].id;
const modelKB = model ? Math.round(statSync(new URL(`../../../public${model.src}`, import.meta.url)).size / 1024) : 0;
const featureLabel: Record<string, string> = { sarcophagus: 'Sarcophagus', shaft: 'Shaft', find: 'Find', damage: 'Damage', opening: 'Opening', feature: 'Feature' };
---

<div class="explorer show-route" data-explorer data-first={burial} data-tour={JSON.stringify(stops)}>
  <div class="bar">
    <div class="tabs" role="tablist" aria-label="View">
      {model && <button type="button" role="tab" aria-selected="true" data-tab="model">3D model <kbd>1</kbd></button>}
      <button type="button" role="tab" aria-selected={model ? 'false' : 'true'} data-tab="plan">Plan <kbd>2</kbd></button>
      <button type="button" role="tab" aria-selected="false" data-tab="profile">Depth profile <kbd>3</kbd></button>
    </div>
    <div class="toggles" role="group" aria-label="Display options">
      <button type="button" data-toggle="show-route" aria-pressed="true">Path <kbd>R</kbd></button>
      <button type="button" data-toggle="evidence" aria-pressed="false">Evidence colours <kbd>E</kbd></button>
      <button type="button" data-toggle="hide-hotspots" data-invert aria-pressed="true">Hotspots <kbd>H</kbd></button>
      <button type="button" data-toggle="show-labels" aria-pressed="false">Labels <kbd>L</kbd></button>
      <button type="button" class="tour-btn" data-tour-start>Guided tour <kbd>T</kbd></button>
    </div>
  </div>

  <div class="stage-wrap">
    {model && (
      <div class="panel panel--model" role="tabpanel" data-panel="model" aria-label="3D model">
        <div class="model" data-model-root data-src={model.src} data-alt={model.alt} data-orbit={full.orbit} data-target={full.target} data-ar={String(model.ar ?? true)} data-hotspots={JSON.stringify(spots)}>
          <Picture class="poster" src={model.poster} alt={model.alt} formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="(min-width: 76rem) 50rem, 100vw" loading="lazy" decoding="async" />
          <button type="button" class="load" data-load>
            <span class="cube" aria-hidden="true"></span>
            <span>Explore the tomb in 3D</span>
            <small>Loads the 3D viewer (about 1 MB) and a {modelKB} KB model</small>
          </button>
          <p class="status" data-status role="status" hidden>Loading 3D viewer…</p>
          <div class="model-tools" data-tools hidden>
            <button type="button" data-overview title="Show the whole tomb (F)">Full view</button>
          </div>
        </div>
      </div>
    )}
    <div class="panel" role="tabpanel" data-panel="plan" aria-label="Plan" hidden={model ? true : undefined}>
      <TombPlan plan={plan} view="plan" />
    </div>
    <div class="panel" role="tabpanel" data-panel="profile" aria-label="Depth profile" hidden>
      <TombPlan plan={plan} view="profile" />
      <p class="legend-note">Unfolded section from the entrance; side rooms are omitted. Depths follow the plan data and are approximate where marked.</p>
    </div>

    <div class="tourcard" data-tourcard hidden aria-live="polite">
      <div class="tour-progress" aria-hidden="true"><span data-tour-bar></span></div>
      <ol class="tour-dots" aria-label="Tour stops">
        {stops.map((s, i) => <li><button type="button" data-tour-go={i} aria-label={`Stop ${i + 1}: ${s.title}`}></button></li>)}
      </ol>
      <p class="tour-count" data-tour-count></p>
      <p class="tour-title" data-tour-title></p>
      <p class="tour-text" data-tour-text></p>
      <div class="tour-nav">
        <button type="button" data-tour-step="-1" aria-label="Previous stop">← Back</button>
        <button type="button" data-tour-step="1" aria-label="Next stop">Next →</button>
        <button type="button" data-tour-end>End tour</button>
      </div>
    </div>
  </div>

  <aside class="side">
    <p class="side-title">Spaces, from the entrance</p>
    <ol class="list">
      {plan.spaces.map((s) => (
        <li>
          <button type="button" data-select={s.id} aria-pressed={s.id === burial ? 'true' : 'false'}>
            <span class="code">{s.code}</span>
            <span class="nm">{s.name}{s.id === burial && <em> · burial</em>}</span>
            <span class:list={['dot', `dot--${s.status}`]} title={STATUS_LONG[s.status]}></span>
          </button>
        </li>
      ))}
    </ol>
    <ul class="key" aria-label="Key">
      <li><span class="sw sw--doc"></span>Documented architecture</li>
      <li><span class="sw sw--rec"></span>Reconstructed geometry</li>
      <li><span class="sw sw--unc"></span>Uncertain, removed or lost</li>
      <li><span class="sw sw--paint"></span>Decorated surface (tint only)</li>
      <li><span class="sw sw--dmg"></span>Damaged</li>
      <li><span class="sw sw--unf"></span>Unfinished</li>
      <li><span class="sw sw--route"></span>Path to the burial chamber</li>
    </ul>
    <details class="keys">
      <summary>Keyboard shortcuts</summary>
      <dl>
        <div><dt><kbd>N</kbd> / <kbd>P</kbd></dt><dd>Next / previous space (or tour stop)</dd></div>
        <div><dt><kbd>F</kbd></dt><dd>Full view of the tomb</dd></div>
        <div><dt><kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd></dt><dd>3D, plan, depth profile</dd></div>
        <div><dt><kbd>R</kbd> <kbd>E</kbd> <kbd>H</kbd> <kbd>L</kbd></dt><dd>Path, evidence colours, hotspots, labels</dd></div>
        <div><dt><kbd>T</kbd> / <kbd>Esc</kbd></dt><dd>Start / end the guided tour</dd></div>
        <div><dt>Arrow keys</dt><dd>Rotate the 3D model when it has focus</dd></div>
      </dl>
    </details>
  </aside>

  <div class="details" aria-live="polite">
    {plan.spaces.map((s) => {
      const fs = features(s);
      return (
        <article class:list={['detail', { 'is-active': s.id === burial }]} id={`space-${s.id}`} data-detail={s.id}>
          <header>
            <p class="kicker">{s.code} · {KIND_LABEL[s.kind]}</p>
            <h3>{s.name}</h3>
            <p class:list={['badge', `badge--${s.status}`]} title={STATUS_HELP[s.status]}>{STATUS_LONG[s.status]}</p>
            {s.condition && <p class:list={['badge', `badge--${s.condition}`]}>{CONDITION_LABEL[s.condition]}</p>}
          </header>
          <p>{s.summary}</p>
          {s.decoration && <p class="deco"><strong>Decoration:</strong> {s.decoration}</p>}
          {s.conditionNote && <p class="cond"><strong>{CONDITION_LABEL[s.condition!]}:</strong> {s.conditionNote}</p>}

          {s.scenes.length > 0 && (
            <section class="sub">
              <h4>Wall scenes</h4>
              <ul class="items">
                {s.scenes.map((sc) => (
                  <li id={`item-${s.id}--${sc.id}`} data-item-detail={`${s.id}--${sc.id}`}>
                    <strong><span class="ico ico--scene" aria-hidden="true">◉</span>{sc.title}</strong>
                    {sc.status !== 'documented' && <span class:list={['badge', 'badge--small', `badge--${sc.status}`]} title="The scene is documented; its position on the model is simplified.">Position simplified</span>}
                    <span>{sc.text}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {fs.length > 0 && (
            <section class="sub">
              <h4>On the model</h4>
              <ul class="items">
                {fs.map((f) => (
                  <li id={`item-${s.id}--${f.id}`} data-item-detail={`${s.id}--${f.id}`}>
                    <strong><span class:list={['ico', `ico--${f.kind}`]} aria-hidden="true" title={featureLabel[f.kind]}></span>{f.title}</strong>
                    {f.status !== 'documented' && <span class:list={['badge', 'badge--small', `badge--${f.status}`]}>{STATUS_LABEL[f.status]}</span>}
                    <span>{f.text}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {s.finds.length > 0 && (
            <section class="sub">
              <h4>Recorded finds</h4>
              <ul class="finds">{s.finds.map((f) => <li>{f}</li>)}</ul>
            </section>
          )}

          <p class="meta">{dimensions(s)} · {depthText(s)}</p>
          {s.caveat && <p class="caveat"><strong>Note:</strong> {s.caveat}</p>}
        </article>
      );
    })}
  </div>

  <footer class="source">
    <h4>Sources for this plan</h4>
    <p>{plan.source}</p>
    {plan.sources.length > 0 && (
      <ol>
        {plan.sources.map((src) => <li>{src.url ? <a href={src.url} rel="noopener">{src.label}</a> : src.label}</li>)}
      </ol>
    )}
    {plan.note && <p>{plan.note}</p>}
    {model?.caption && <p>{model.caption}</p>}
    <p>Interpretive model of {name}. Surfaces are flat colours: decoration is shown as a tint, never redrawn, and nothing is modelled where no plan exists. <noscript>Enable JavaScript for the 3D view and tour; the plan, profile and all descriptions are shown here.</noscript></p>
  </footer>
</div>

<script>
  type Spot = { type: 'space' | 'scene' | 'feature'; id: string; space: string; kind?: string; label: string; title: string; status: string; position: string; normal: string; target: string; orbit: string };
  type Stop = { space: string; scene?: string; text: string; title: string };
  type ModelViewer = HTMLElement & {
    cameraTarget: string; cameraOrbit: string;
    model?: { materials: { name: string; setEmissiveFactor(c: number[]): void; setAlphaMode(m: string): void; pbrMetallicRoughness: { setBaseColorFactor(c: number[]): void } }[] };
  };

  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const hasWebGL = () => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  };

  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const modelRoot = root.querySelector<HTMLElement>('[data-model-root]');
    const spots: Spot[] = modelRoot ? JSON.parse(modelRoot.dataset.hotspots!) : [];
    const stops: Stop[] = JSON.parse(root.dataset.tour!);
    const order = [...root.querySelectorAll<HTMLElement>('[data-select]')].map((b) => b.dataset.select!);
    let mv: ModelViewer | null = null;
    let current = root.dataset.first!;
    let tourAt = -1;

    // ------------------------------------------------------------ tabs
    const showTab = (name: string, focus = false) => {
      if (!tabs.some((t) => t.dataset.tab === name)) return;
      tabs.forEach((t) => {
        const on = t.dataset.tab === name;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== name));
    };
    tabs.forEach((t, i) => {
      t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1;
      t.addEventListener('click', () => showTab(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) showTab(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });

    // ------------------------------------------------------------ toggles
    const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-toggle]')];
    const applyMaterials = () => {
      if (!mv?.model) return;
      const evidence = root.classList.contains('evidence');
      const route = root.classList.contains('show-route');
      for (const m of mv.model.materials) {
        if (m.name === 'Documented architecture') m.pbrMetallicRoughness.setBaseColorFactor(evidence ? [0.45, 0.95, 0.9, 1] : [1, 1, 1, 1]);
        if (m.name === 'Reconstructed geometry') m.pbrMetallicRoughness.setBaseColorFactor(evidence ? [1, 0.72, 0.35, 1] : [1, 1, 1, 1]);
        if (m.name === 'Route') {
          m.pbrMetallicRoughness.setBaseColorFactor([0.95, 0.76, 0.31, route ? 1 : 0]);
          m.setEmissiveFactor(route ? [0.57, 0.45, 0.18] : [0, 0, 0]);
        }
      }
    };
    const setToggle = (btn: HTMLButtonElement, on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      root.classList.toggle(btn.dataset.toggle!, btn.hasAttribute('data-invert') ? !on : on);
      applyMaterials();
    };
    toggles.forEach((b) => b.addEventListener('click', () => setToggle(b, b.getAttribute('aria-pressed') !== 'true')));
    const flip = (name: string) => {
      const b = toggles.find((t) => t.dataset.toggle === name);
      if (b) setToggle(b, b.getAttribute('aria-pressed') !== 'true');
    };

    // ------------------------------------------------------------ selection
    const fly = (spot?: Spot) => {
      if (!mv || !spot) return;
      mv.cameraTarget = spot.target;
      mv.cameraOrbit = spot.orbit;
    };
    const overview = () => {
      if (!mv) return;
      mv.cameraTarget = modelRoot!.dataset.target!;
      mv.cameraOrbit = modelRoot!.dataset.orbit!;
    };
    const markItem = (item?: string) => {
      root.querySelectorAll('[data-item]').forEach((m) => m.classList.toggle('is-active', (m as HTMLElement).dataset.item === item));
      root.querySelectorAll('.hs--scene, .hs--feature').forEach((h) => h.classList.toggle('is-active', (h as HTMLElement).dataset.id === item));
      root.querySelectorAll('[data-item-detail]').forEach((d) => d.classList.toggle('is-active', (d as HTMLElement).dataset.itemDetail === item));
    };
    const select = (id: string, { camera = true, item }: { camera?: boolean; item?: string } = {}) => {
      current = id;
      root.querySelectorAll<HTMLElement>('[data-select]').forEach((b) => {
        const on = b.dataset.select === id;
        b.setAttribute('aria-pressed', String(on));
        const li = b.parentElement!, list = li.parentElement!;
        if (on) list.scrollTo({ left: li.offsetLeft - list.offsetLeft - 8, top: li.offsetTop - list.offsetTop - 8 });
      });
      root.querySelectorAll('.space[data-space]').forEach((g) => g.classList.toggle('is-active', (g as HTMLElement).dataset.space === id));
      root.querySelectorAll<HTMLElement>('[data-detail]').forEach((d) => d.classList.toggle('is-active', d.dataset.detail === id));
      root.querySelectorAll<HTMLElement>('.hs--space').forEach((h) => h.classList.toggle('is-active', h.dataset.id === id));
      // Scene and feature hotspots appear for the selected space only, to keep the view readable.
      root.querySelectorAll<HTMLElement>('.hs--scene, .hs--feature').forEach((h) => h.classList.toggle('in-focus', h.dataset.space === id));
      markItem(item);
      if (camera) fly(spots.find((h) => h.id === (item?.includes('--') && item.split('--')[0] === id && spots.find((x) => x.id === item)?.type === 'scene' ? item : id)));
    };
    root.querySelectorAll<HTMLElement>('[data-select]').forEach((b) => b.addEventListener('click', () => { endTour(); select(b.dataset.select!); }));
    root.querySelectorAll<SVGElement>('[data-space]').forEach((g) => {
      const act = () => { endTour(); select(g.dataset.space!, { item: g.dataset.item }); };
      g.addEventListener('click', (e) => { e.stopPropagation(); act(); });
      g.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'Enter' || k === ' ') { e.preventDefault(); e.stopPropagation(); act(); }
      });
    });
    select(current, { camera: false });

    // ------------------------------------------------------------ guided tour
    const card = root.querySelector<HTMLElement>('[data-tourcard]')!;
    const goTour = (i: number) => {
      tourAt = (i + stops.length) % stops.length;
      const s = stops[tourAt];
      card.hidden = false;
      root.classList.add('touring');
      card.querySelector('[data-tour-count]')!.textContent = `Stop ${tourAt + 1} of ${stops.length}`;
      card.querySelector('[data-tour-title]')!.textContent = s.title;
      card.querySelector('[data-tour-text]')!.textContent = s.text;
      card.querySelector<HTMLElement>('[data-tour-bar]')!.style.width = `${((tourAt + 1) / stops.length) * 100}%`;
      card.querySelectorAll('[data-tour-go]').forEach((d, j) => d.setAttribute('aria-current', j === tourAt ? 'step' : 'false'));
      select(s.space, { item: s.scene ? `${s.space}--${s.scene}` : undefined });
    };
    function endTour() {
      if (tourAt < 0) return;
      tourAt = -1;
      // Keep keyboard focus inside the explorer when the card disappears.
      const hadFocus = card.contains(document.activeElement);
      card.hidden = true;
      root.classList.remove('touring');
      if (hadFocus) root.querySelector<HTMLButtonElement>('[data-tour-start]')!.focus();
    }
    root.querySelector('[data-tour-start]')!.addEventListener('click', () => (tourAt >= 0 ? endTour() : goTour(0)));
    card.querySelectorAll<HTMLButtonElement>('[data-tour-step]').forEach((b) => b.addEventListener('click', () => goTour(tourAt + Number(b.dataset.tourStep))));
    card.querySelector('[data-tour-end]')!.addEventListener('click', () => { endTour(); overview(); });
    card.querySelectorAll<HTMLButtonElement>('[data-tour-go]').forEach((d) => d.addEventListener('click', () => goTour(Number(d.dataset.tourGo))));

    // ------------------------------------------------------------ keyboard
    root.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.altKey || e.ctrlKey || e.metaKey || t.closest('input, textarea, select')) return;
      const step = (d: number) => (tourAt >= 0 ? goTour(tourAt + d) : select(order[(order.indexOf(current) + d + order.length) % order.length]));
      const map: Record<string, () => void> = {
        n: () => step(1), p: () => step(-1), f: () => { endTour(); overview(); },
        1: () => showTab('model'), 2: () => showTab('plan'), 3: () => showTab('profile'),
        r: () => flip('show-route'), e: () => flip('evidence'), h: () => flip('hide-hotspots'), l: () => flip('show-labels'),
        t: () => (tourAt >= 0 ? endTour() : goTour(0)), Escape: () => { endTour(); overview(); },
      };
      const fn = map[e.key.length === 1 ? e.key.toLowerCase() : e.key];
      if (fn) { e.preventDefault(); fn(); }
    });

    // ------------------------------------------------------------ 3D, loaded on request
    const load = modelRoot?.querySelector<HTMLButtonElement>('[data-load]');
    const status = modelRoot?.querySelector<HTMLElement>('[data-status]');
    const fallback = (msg: string) => {
      if (!status || !load) return;
      load.hidden = true;
      status.hidden = false;
      status.textContent = msg;
      showTab('plan');
    };
    if (modelRoot && !hasWebGL()) {
      fallback('3D needs WebGL, which this browser does not provide. The plan and depth profile show the same tomb.');
    }
    load?.addEventListener('click', async () => {
      load.hidden = true;
      status!.hidden = false;
      try {
        await import('@google/model-viewer');
        const d = modelRoot!.dataset;
        mv = document.createElement('model-viewer') as ModelViewer;
        const attrs: Record<string, string> = {
          src: d.src!, alt: d.alt!, 'camera-controls': '', 'touch-action': 'pan-y', 'camera-orbit': d.orbit!, 'camera-target': d.target!,
          'interpolation-decay': reduceMotion ? '20' : '160', 'shadow-intensity': '0.8', exposure: '0.9', 'tone-mapping': 'aces',
          'environment-image': 'neutral', 'min-camera-orbit': 'auto 0deg 0.02m', 'max-camera-orbit': 'auto 88deg auto',
          'interaction-prompt': 'none', loading: 'eager',
        };
        if (d.ar === 'true') Object.assign(attrs, { ar: '', 'ar-modes': 'webxr scene-viewer quick-look' });
        for (const [k, v] of Object.entries(attrs)) mv.setAttribute(k, v);

        spots.forEach((h, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.slot = `hotspot-${i}`;
          b.className = `hs hs--${h.type}${h.kind ? ` hs--${h.kind}` : ''}${h.status === 'uncertain' ? ' hs--uncertain' : ''}`;
          b.dataset.id = h.id;
          b.dataset.space = h.space;
          b.dataset.position = h.position;
          b.dataset.normal = h.normal;
          b.dataset.visibilityAttribute = 'visible';
          b.textContent = h.label;
          b.setAttribute('aria-label', h.type === 'space' ? `${h.label}: ${h.title}` : `${h.type === 'scene' ? 'Scene' : 'Feature'}: ${h.title}`);
          const tip = document.createElement('span');
          tip.className = 'hs-tip';
          tip.textContent = h.title;
          b.append(tip);
          b.addEventListener('click', () => {
            endTour();
            select(h.space, { item: h.type === 'space' ? undefined : h.id });
            if (h.type !== 'space') document.getElementById(`item-${h.id}`)?.scrollIntoView({ block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
          });
          mv!.append(b);
        });

        mv.addEventListener('load', () => {
          status!.hidden = true;
          modelRoot!.classList.add('is-live');
          modelRoot!.querySelector<HTMLElement>('[data-tools]')!.hidden = false;
          for (const m of mv!.model?.materials ?? []) if (m.name === 'Route') m.setAlphaMode('BLEND');
          applyMaterials();
          // Open on the whole tomb; the selection only moves the camera when asked.
          select(current, { camera: false });
        });
        mv.addEventListener('error', () => fallback('The 3D model could not be loaded. The plan and depth profile show the same tomb.'));
        modelRoot!.append(mv);
      } catch {
        fallback('The 3D viewer could not be loaded. The plan and depth profile show the same tomb.');
      }
    });
    modelRoot?.querySelector('[data-overview]')?.addEventListener('click', () => { endTour(); overview(); });
  });
</script>

<style>
  .explorer {
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: 1fr;
    grid-template-areas: 'bar' 'stage' 'side' 'details' 'source';
  }
  @media (min-width: 64rem) {
    .explorer {
      grid-template-columns: minmax(0, 1fr) 19rem;
      grid-template-areas: 'bar bar' 'stage side' 'details side' 'source source';
    }
  }
  .bar { grid-area: bar; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem 1.5rem; }
  .tabs, .toggles { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .bar button {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font: inherit; font-size: 0.82rem; min-height: 2.5rem; padding: 0.35rem 0.9rem;
    border: 1px solid var(--line-strong); border-radius: 999px; background: transparent; color: var(--text-muted); cursor: pointer;
  }
