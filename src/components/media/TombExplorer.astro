---
/**
 * The tomb explorer: an interactive 3D cutaway (lazy-loaded <model-viewer>
 * with chamber and scene hotspots), the plan and a depth profile, all drawn
 * from the same plan data, plus a chamber list and detail panel that stay in
 * sync. Every chamber's text is in the HTML, so it is crawlable and readable
 * without JavaScript; the 3D view is an optional enhancement.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TombPlan from './TombPlan.astro';
import {
  KIND_LABEL, STATUS_HELP, STATUS_LABEL, depthText, dimensions, hotspot, orbit, wallHotspot, type Plan,
} from '@/lib/plans';

export interface Props {
  plan: Plan;
  model?: { src: string; poster: ImageMetadata; alt: string; caption?: string; ar?: boolean };
  name: string;
}
const { plan, model, name } = Astro.props;
const first = plan.spaces.find((s) => s.sarcophagus) ?? plan.spaces[0];

const hotspots = plan.spaces.flatMap((s) => [
  { type: 'space', id: s.id, label: s.code, title: s.name, position: hotspot(s), normal: '0 1 0', ...orbit(s, plan) },
  ...s.scenes.map((sc) => ({
    type: 'scene', id: `${s.id}--${sc.id}`, space: s.id, label: '◉', title: sc.title, ...wallHotspot(s, sc.wall), ...orbit(s, plan),
  })),
]);
const overview = `${plan.camera.theta}deg ${plan.camera.phi}deg auto`;
const scenes = plan.spaces.flatMap((s) => s.scenes.map((sc) => ({ s, sc })));
---

<div class="explorer" data-explorer data-first={first.id}>
  <div class="tabs" role="tablist" aria-label="View">
    {model && <button type="button" role="tab" aria-selected="true" data-tab="model">3D model</button>}
    <button type="button" role="tab" aria-selected={model ? 'false' : 'true'} data-tab="plan">Plan</button>
    <button type="button" role="tab" aria-selected="false" data-tab="profile">Depth profile</button>
  </div>

  <div class="stage-wrap">
    {model && (
      <div class="panel panel--model" role="tabpanel" data-panel="model" aria-label="3D model">
        <div class="model" data-model-root data-src={model.src} data-alt={model.alt} data-orbit={overview} data-ar={String(model.ar ?? true)} data-hotspots={JSON.stringify(hotspots)}>
          <Picture class="poster" src={model.poster} alt={model.alt} formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="(min-width: 76rem) 50rem, 100vw" loading="lazy" decoding="async" />
          <button type="button" class="load" data-load>
            <span class="cube" aria-hidden="true"></span>
            <span>Explore the tomb in 3D</span>
            <small>Rotate, zoom and tap the numbered hotspots</small>
          </button>
          <p class="status" data-status hidden>Loading 3D viewer…</p>
          <div class="model-tools" data-tools hidden>
            <button type="button" data-overview>Whole tomb</button>
            {scenes.length > 0 && <button type="button" data-scenes aria-pressed="true">Scene hotspots</button>}
          </div>
        </div>
        <ul class="legend" aria-label="Model colours">
          <li><span class="sw sw--painted"></span>Decorated walls (colour zones only; scenes not reproduced)</li>
          <li><span class="sw sw--plain"></span>Undecorated rock</li>
          <li><span class="sw sw--ghost"></span>Removed, lost or uncertain</li>
        </ul>
      </div>
    )}
    <div class="panel" role="tabpanel" data-panel="plan" aria-label="Plan" hidden={model ? true : undefined}>
      <TombPlan plan={plan} view="plan" />
      <ul class="legend" aria-label="Plan key">
        <li><span class="sw sw--line"></span>Decorated wall</li>
        <li><span class="sw sw--sarc"></span>Sarcophagus in place</li>
        <li><span class="sw sw--ghost"></span>Removed or lost; uncertain space</li>
        <li><span class="sw sw--steps"></span>Stairs (arrow points down)</li>
      </ul>
    </div>
    <div class="panel" role="tabpanel" data-panel="profile" aria-label="Depth profile" hidden>
      <TombPlan plan={plan} view="profile" />
      <p class="legend-note">Unfolded section along the route from the entrance; side rooms are omitted. Depths are approximate.</p>
    </div>
  </div>

  <aside class="side">
    <p class="side-title">Spaces, from the entrance</p>
    <ol class="list">
      {plan.spaces.map((s) => (
        <li>
          <button type="button" data-select={s.id} aria-pressed={s.id === first.id ? 'true' : 'false'}>
            <span class="code">{s.code}</span>
            <span class="nm">{s.name}</span>
            <span class:list={['dot', `dot--${s.status}`]} title={STATUS_LABEL[s.status]}></span>
          </button>
        </li>
      ))}
    </ol>
  </aside>

  <div class="details" aria-live="polite">
    {plan.spaces.map((s) => (
      <article class:list={['detail', { 'is-active': s.id === first.id }]} id={`space-${s.id}`} data-detail={s.id}>
        <header>
          <p class="kicker">{s.code} · {KIND_LABEL[s.kind]}</p>
          <h3>{s.name}</h3>
          <p class:list={['badge', `badge--${s.status}`]} title={STATUS_HELP[s.status]}>{STATUS_LABEL[s.status]}</p>
        </header>
        <p>{s.summary}</p>
        {s.decoration && <p class="deco"><strong>Decoration:</strong> {s.decoration}</p>}
        {s.sarcophagus && <p class="deco"><strong>Sarcophagus:</strong> {s.sarcophagus.label}.</p>}
        {s.scenes.length > 0 && (
          <ul class="scenes">
            {s.scenes.map((sc) => (
              <li id={`scene-${s.id}--${sc.id}`}>
                <strong>{sc.title}</strong>
                {sc.status !== 'documented' && <span class:list={['badge', 'badge--small', `badge--${sc.status}`]}>{STATUS_LABEL[sc.status]}</span>}
                <span>{sc.text}</span>
              </li>
            ))}
          </ul>
        )}
        <p class="meta">{dimensions(s)} · {depthText(s)}</p>
        {s.caveat && <p class="caveat"><strong>Note:</strong> {s.caveat}</p>}
      </article>
    ))}
  </div>

  <footer class="source">
    <p><strong>Source:</strong> {plan.source}</p>
    {plan.note && <p>{plan.note}</p>}
    {model?.caption && <p>{model.caption}</p>}
    <p class="noscript-hint">Interpretive model of {name}. <noscript>Enable JavaScript to open the 3D view; the plan and all chamber descriptions are shown below.</noscript></p>
  </footer>
</div>

<script>
  type Hotspot = { type: 'space' | 'scene'; id: string; space?: string; label: string; title: string; position: string; normal: string; target: string; orbit: string };

  document.querySelectorAll<HTMLElement>('[data-explorer]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const modelRoot = root.querySelector<HTMLElement>('[data-model-root]');
    let mv: (HTMLElement & { cameraTarget?: string; cameraOrbit?: string }) | null = null;
    let current = root.dataset.first!;
    const hotspots: Hotspot[] = modelRoot ? JSON.parse(modelRoot.dataset.hotspots!) : [];

    // ---- tabs (arrow keys move between them, per the ARIA tabs pattern)
    const showTab = (name: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === name;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== name));
    };
    tabs.forEach((t, i) => {
      t.tabIndex = t.getAttribute('aria-selected') === 'true' ? 0 : -1;
      t.addEventListener('click', () => showTab(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) showTab(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });

    // ---- selection shared by list, plan, profile, 3D and details
    const select = (id: string, { fly = true } = {}) => {
      current = id;
      root.querySelectorAll<HTMLElement>('[data-select]').forEach((b) => {
        const on = b.dataset.select === id;
        b.setAttribute('aria-pressed', String(on));
        // Keep the chosen chamber visible in the list without scrolling the page.
        const li = b.parentElement!, list = li.parentElement!;
        if (on) list.scrollTo({ left: li.offsetLeft - list.offsetLeft - 8, top: li.offsetTop - list.offsetTop - 8 });
      });
      root.querySelectorAll('[data-space]').forEach((g) => g.classList.toggle('is-active', (g as HTMLElement).dataset.space === id));
      root.querySelectorAll<HTMLElement>('[data-detail]').forEach((d) => d.classList.toggle('is-active', d.dataset.detail === id));
      root.querySelectorAll<HTMLElement>('.hs--space').forEach((h) => h.classList.toggle('is-active', h.dataset.id === id));
      if (fly && mv) {
        const spot = hotspots.find((h) => h.type === 'space' && h.id === id);
        if (spot) {
          mv.cameraTarget = spot.target;
          mv.cameraOrbit = spot.orbit;
        }
      }
    };
    root.querySelectorAll<HTMLElement>('[data-select]').forEach((b) => b.addEventListener('click', () => select(b.dataset.select!)));
    root.querySelectorAll<SVGElement>('[data-space]').forEach((g) => {
      g.addEventListener('click', () => select(g.dataset.space!));
      g.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          select(g.dataset.space!);
        }
      });
    });
    select(current, { fly: false });

    // ---- 3D model, loaded on request
    const load = modelRoot?.querySelector<HTMLButtonElement>('[data-load]');
    load?.addEventListener('click', async () => {
      const status = modelRoot!.querySelector<HTMLElement>('[data-status]')!;
      load.hidden = true;
      status.hidden = false;
      try {
        await import('@google/model-viewer');
        const d = modelRoot!.dataset;
        mv = document.createElement('model-viewer');
        const attrs: Record<string, string> = {
          src: d.src!, alt: d.alt!, 'camera-controls': '', 'touch-action': 'pan-y', 'camera-orbit': d.orbit!,
          'interpolation-decay': '140', 'shadow-intensity': '0.8', exposure: '0.9', 'tone-mapping': 'aces',
          'environment-image': 'neutral', 'min-camera-orbit': 'auto 0deg 0.02m', 'max-camera-orbit': 'auto 88deg auto',
          'interaction-prompt': 'none', loading: 'eager',
        };
        if (d.ar === 'true') Object.assign(attrs, { ar: '', 'ar-modes': 'webxr scene-viewer quick-look' });
        for (const [k, v] of Object.entries(attrs)) mv.setAttribute(k, v);

        hotspots.forEach((h, i) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.slot = `hotspot-${i}`;
          b.className = `hs hs--${h.type}`;
          b.dataset.id = h.type === 'space' ? h.id : h.space!;
          b.dataset.position = h.position;
          b.dataset.normal = h.normal;
          b.dataset.visibilityAttribute = 'visible';
          b.textContent = h.label;
          b.setAttribute('aria-label', h.type === 'space' ? `${h.label}: ${h.title}` : `Scene: ${h.title}`);
          const tip = document.createElement('span');
          tip.className = 'hs-tip';
          tip.textContent = h.title;
          b.append(tip);
          b.addEventListener('click', () => {
            select(h.type === 'space' ? h.id : h.space!);
            if (h.type === 'scene') document.getElementById(`scene-${h.id}`)?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          });
          mv!.append(b);
        });

        mv.addEventListener('load', () => {
          status.hidden = true;
          modelRoot!.classList.add('is-live');
          modelRoot!.querySelector<HTMLElement>('[data-tools]')!.hidden = false;
          select(current, { fly: false }); // start on the whole tomb
        });
        mv.addEventListener('error', () => (status.textContent = 'The 3D model could not be loaded. The plan and depth profile tabs show the same layout.'));
        modelRoot!.append(mv);
      } catch {
        status.textContent = 'The 3D viewer could not be loaded. The plan and depth profile tabs show the same layout.';
      }
    });

    modelRoot?.querySelector('[data-overview]')?.addEventListener('click', () => {
      if (!mv) return;
      mv.cameraTarget = 'auto auto auto';
      mv.cameraOrbit = modelRoot.dataset.orbit!;
    });
    const scenesBtn = modelRoot?.querySelector<HTMLButtonElement>('[data-scenes]');
    scenesBtn?.addEventListener('click', () => {
      const on = scenesBtn.getAttribute('aria-pressed') !== 'true';
      scenesBtn.setAttribute('aria-pressed', String(on));
      modelRoot!.classList.toggle('hide-scenes', !on);
    });
  });
</script>

<style>
  .explorer {
    display: grid;
    gap: 1.25rem 2rem;
    grid-template-columns: 1fr;
    grid-template-areas: 'tabs' 'stage' 'side' 'details' 'source';
  }
  @media (min-width: 64rem) {
    .explorer {
      grid-template-columns: minmax(0, 1fr) 19rem;
      grid-template-areas: 'tabs tabs' 'stage side' 'details side' 'source source';
    }
  }
  .tabs { grid-area: tabs; display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tabs button {
    font: inherit; font-size: 0.85rem; min-height: 2.5rem; padding: 0.4rem 1rem;
    border: 1px solid var(--line-strong); border-radius: 999px; background: transparent; color: var(--text-muted); cursor: pointer;
  }
  .tabs button[aria-selected='true'] { background: var(--gold); border-color: var(--gold); color: var(--basalt); }
  /* Without JS, show every panel stacked; tabs are only an enhancement. */
  :global(html:not(.js)) .tabs { display: none; }
  :global(html:not(.js)) .panel[hidden] { display: block !important; margin-top: 1.5rem; }
  .stage-wrap { grid-area: stage; min-width: 0; }
  .panel { border: 1px solid var(--line-strong); border-radius: var(--radius); background: radial-gradient(ellipse at 50% 30%, #231d14, #0d0b08 75%); padding: 0.75rem; }

  .model { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: var(--radius); }
  @media (max-width: 40rem) {
    .model { aspect-ratio: 4 / 3.4; }
    .load { padding: 0.6rem 1rem; font-size: 0.75rem; }
    .load small { display: none; }
  }
  .model :global(.poster), .model :global(.poster img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .model.is-live :global(.poster) { opacity: 0; transition: opacity 0.6s var(--ease); pointer-events: none; }
  .model :global(model-viewer) { position: absolute; inset: 0; width: 100%; height: 100%; --poster-color: transparent; --progress-bar-color: var(--gold); }
  .load {
    position: absolute; left: 50%; bottom: 1rem; transform: translateX(-50%);
    display: grid; justify-items: center; gap: 0.15rem; padding: 0.8rem 1.3rem;
    border: 1px solid var(--gold); border-radius: var(--radius); background: rgb(11 10 8 / 0.85); backdrop-filter: blur(6px);
    color: var(--limestone); font-family: var(--font-display); letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.82rem; cursor: pointer;
    white-space: nowrap;
  }
  .load:hover { box-shadow: var(--glow); }
  .load small { font-family: var(--font-body); text-transform: none; letter-spacing: 0.02em; color: var(--text-muted); font-size: 0.72rem; }
  .cube { width: 1.3rem; height: 1.3rem; border: 1.5px solid var(--gold); transform: rotate(45deg) skew(8deg, 8deg); margin-bottom: 0.3rem; }
  .status { position: absolute; left: 50%; bottom: 1.2rem; transform: translateX(-50%); margin: 0; padding: 0.4rem 0.9rem; border-radius: 999px; background: rgb(11 10 8 / 0.85); color: var(--text-muted); font-size: 0.85rem; max-width: 90%; text-align: center; }
  .model-tools { position: absolute; top: 0.6rem; right: 0.6rem; z-index: 2; display: flex; gap: 0.4rem; }
  .model-tools button { font: inherit; font-size: 0.75rem; min-height: 2.25rem; padding: 0.3rem 0.8rem; border: 1px solid var(--line-strong); border-radius: 999px; background: rgb(11 10 8 / 0.8); color: var(--text); cursor: pointer; }
  .model-tools button[aria-pressed='true'] { border-color: var(--gold); color: var(--accent-bright); }

  /* Hotspots are created by script inside <model-viewer>, so they need :global. */
  .model :global(.hs) {
    position: relative;
    display: grid; place-items: center;
    width: 1.9rem; height: 1.9rem; padding: 0;
    border: 1.5px solid var(--limestone); border-radius: 50%;
    background: rgb(11 10 8 / 0.85); color: var(--limestone);
    font: 600 0.72rem var(--font-display); cursor: pointer;
    transition: transform 0.2s var(--ease), background 0.2s;
  }
  .model :global(.hs--scene) { width: 1.5rem; height: 1.5rem; border-color: var(--gold); color: var(--gold); font-size: 0.7rem; }
  .model :global(.hs:not([data-visible])) { opacity: 0.35; }
  .model :global(.hs:hover), .model :global(.hs:focus-visible), .model :global(.hs.is-active) { transform: scale(1.18); background: var(--gold); border-color: var(--gold); color: var(--basalt); outline: none; }
  .model :global(.hs-tip) {
    position: absolute; left: 50%; bottom: calc(100% + 0.4rem); transform: translateX(-50%);
    padding: 0.2rem 0.55rem; border-radius: 3px; white-space: nowrap;
    background: rgb(11 10 8 / 0.92); color: var(--text); font: 500 0.72rem var(--font-body); letter-spacing: 0;
    opacity: 0; pointer-events: none; transition: opacity 0.2s;
  }
  .model :global(.hs:hover .hs-tip), .model :global(.hs:focus-visible .hs-tip), .model :global(.hs.is-active .hs-tip) { opacity: 1; }
  .model.hide-scenes :global(.hs--scene) { display: none; }

  .legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; list-style: none; margin: 0.7rem 0 0; padding: 0; font-size: 0.75rem; color: var(--text-muted); }
  .legend li { display: inline-flex; align-items: center; gap: 0.4rem; }
  .sw { display: inline-block; width: 0.9rem; height: 0.6rem; border-radius: 2px; }
  .sw--painted { background: linear-gradient(#2c5876 0 20%, #d9b04f 20% 80%, #5b2d1f 80%); }
  .sw--plain { background: #cdb893; }
  .sw--ghost { background: rgb(127 167 217 / 0.35); border: 1px dashed #7fa7d9; }
  .sw--line { height: 3px; background: var(--gold); }
  .sw--sarc { background: #9a5a44; border: 1px solid var(--limestone); }
  .sw--steps { background: repeating-linear-gradient(90deg, #2f271b 0 3px, rgb(216 203 168 / 0.5) 3px 4px); }
  .legend-note { margin: 0.6rem 0 0; font-size: 0.75rem; color: var(--text-faint); }

  .side { grid-area: side; min-width: 0; }
  .side-title { margin: 0 0 0.5rem; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  @media (min-width: 64rem) { .list { max-height: 34rem; overflow-y: auto; padding-right: 0.3rem; scrollbar-color: var(--line-strong) transparent; } }
  @media (max-width: 63.99rem) {
    .list { grid-auto-flow: column; grid-auto-columns: minmax(11rem, 1fr); overflow-x: auto; padding-bottom: 0.5rem; scroll-snap-type: x proximity; }
    .list li { scroll-snap-align: start; }
  }
  .list button {
    display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: 0.5rem;
    width: 100%; min-height: 2.75rem; padding: 0.4rem 0.6rem; text-align: left;
    border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-raised); color: var(--text); font: inherit; font-size: 0.85rem; cursor: pointer;
  }
  .list button:hover { border-color: var(--line-strong); }
  .list button[aria-pressed='true'] { border-color: var(--gold); background: rgb(200 149 43 / 0.12); }
  .list .code { display: grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 50%; border: 1px solid var(--line-strong); font: 600 0.72rem var(--font-display); color: var(--limestone); }
  .list button[aria-pressed='true'] .code { background: var(--gold); border-color: var(--gold); color: var(--basalt); }
  .dot { width: 0.55rem; height: 0.55rem; border-radius: 50%; }
  .dot--documented { background: var(--faience); }
  .dot--approximate { background: var(--gold); }
  .dot--uncertain { background: transparent; border: 1.5px dashed #7fa7d9; }

  .details { grid-area: details; min-width: 0; }
  :global(.js) .detail:not(.is-active) { display: none; }
  .detail { padding: 1.25rem 1.4rem; border: 1px solid var(--line); border-left: 3px solid var(--gold); border-radius: var(--radius); background: var(--bg-panel); }
  :global(html:not(.js)) .detail + .detail { margin-top: 1rem; }
  .detail header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.8rem; margin-bottom: 0.6rem; }
  .detail .kicker { margin: 0; width: 100%; }
  .detail h3 { margin: 0; font-size: var(--step-1); }
  .detail p { color: var(--text-muted); }
  .deco strong, .caveat strong { color: var(--limestone); }
  .meta { font-size: var(--step--1); color: var(--text-faint) !important; margin: 0; }
  .caveat { margin: 0.6rem 0 0; font-size: var(--step--1); padding: 0.5rem 0.7rem; border-left: 2px solid #7fa7d9; background: rgb(127 167 217 / 0.06); }
  .scenes { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.7rem; }
  .scenes li { display: grid; gap: 0.15rem; padding-left: 0.9rem; border-left: 1px solid var(--line-strong); font-size: 0.92rem; color: var(--text-muted); }
  .scenes strong { color: var(--limestone); font-weight: 600; }
  .badge { margin: 0; padding: 0.1rem 0.55rem; border-radius: 999px; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; border: 1px solid; }
  .badge--small { justify-self: start; font-size: 0.62rem; }
  .badge--documented { color: #7fd1c8; border-color: var(--faience); }
  .badge--approximate { color: var(--accent-bright); border-color: var(--gold); }
  .badge--uncertain { color: #a9c4e8; border-color: #7fa7d9; border-style: dashed; }

  .source { grid-area: source; font-size: var(--step--1); color: var(--text-faint); }
  .source p { margin: 0 0 0.3rem; }
  .source strong { color: var(--text-muted); }
</style>
