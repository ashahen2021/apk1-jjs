---
/**
 * Plan and depth profile of a tomb, drawn as inline SVG from plan data.
 * Each space is focusable and announces its name; TombExplorer wires the
 * selection. Works as a static, crawlable diagram without JavaScript.
 */
import { bounds, center, type Plan, type Space } from '@/lib/plans';

export interface Props { plan: Plan; view: 'plan' | 'profile' }
const { plan, view } = Astro.props;
const b = bounds(plan);
const uid = plan.title.toLowerCase().replace(/\W+/g, '-');

// ---------------------------------------------------------------- plan view
const rotate = b.y1 - b.y0 > (b.x1 - b.x0) * 1.4; // long tombs run left → right
const M = 3;
const P = (x: number, y: number): [number, number] => (rotate ? [y - b.y0 + M, b.x1 - x + M] : [x - b.x0 + M, y - b.y0 + M]);
const W = (rotate ? b.y1 - b.y0 : b.x1 - b.x0) + 2 * M;
const H = (rotate ? b.x1 - b.x0 : b.y1 - b.y0) + 2 * M;
const u = W / 820; // user units per CSS pixel at the design width

const rect = (x0: number, x1: number, y0: number, y1: number) => {
  const [a, c] = [P(x0, y0), P(x1, y1)];
  return { x: Math.min(a[0], c[0]), y: Math.min(a[1], c[1]), width: Math.abs(c[0] - a[0]), height: Math.abs(c[1] - a[1]) };
};
const wallLine = (s: Space, wall: string) => {
  const [x0, x1] = s.x, [y0, y1] = s.y;
  const [p, q] = { n: [P(x0, y0), P(x1, y0)], s: [P(x0, y1), P(x1, y1)], w: [P(x0, y0), P(x0, y1)], e: [P(x1, y0), P(x1, y1)] }[wall]!;
  return { x1: p[0], y1: p[1], x2: q[0], y2: q[1] };
};
const hatch = (s: Space) => {
  if (s.kind !== 'stairs' || !s.descends) return [];
  const along = s.descends[0];
  const [a0, a1] = along === 'x' ? s.x : s.y;
  const n = Math.max(3, Math.round((a1 - a0) / 0.6));
  return Array.from({ length: n - 1 }, (_, i) => {
    const t = a0 + ((i + 1) * (a1 - a0)) / n;
    const [p, q] = along === 'x' ? [P(t, s.y[0]), P(t, s.y[1])] : [P(s.x[0], t), P(s.x[1], t)];
    return { x1: p[0], y1: p[1], x2: q[0], y2: q[1] };
  });
};
const arrow = (s: Space) => {
  if (!s.descends) return undefined;
  const [cx, cy] = center(s);
  const d = { 'x+': [1, 0], 'x-': [-1, 0], 'y+': [0, 1], 'y-': [0, -1] }[s.descends]!;
  const len = Math.min(3, (s.descends[0] === 'x' ? s.x[1] - s.x[0] : s.y[1] - s.y[0]) * 0.3);
  const [p, q] = [P(cx - d[0] * len, cy - d[1] * len), P(cx + d[0] * len, cy + d[1] * len)];
  return { x1: p[0], y1: p[1], x2: q[0], y2: q[1] };
};
const scaleLen = W > 90 ? 20 : W > 45 ? 10 : 5;

// ---------------------------------------------------------------- profile view
const route = plan.spaces.filter((s) => s.kind !== 'annex');
let run = 0;
const segs = route.map((s) => {
  const len = s.descends ? (s.descends[0] === 'x' ? s.x[1] - s.x[0] : s.y[1] - s.y[0]) : Math.max(s.x[1] - s.x[0], s.y[1] - s.y[0]);
  const seg = { s, x0: run, x1: run + len };
  run += len;
  return seg;
});
const total = run;
const deepest = -b.deepest;
const exaggerate = total / Math.max(deepest, 1) > 7 ? 2 : 1;
const PM = 4;
const PW = total + 2 * PM;
const PH = (deepest + 6) * exaggerate + 2 * PM;
const pu = PW / 820;
const PY = (depth: number) => PM + (4 - depth) * exaggerate; // depth is negative below ground
const ticks = Array.from({ length: Math.floor(deepest / (deepest > 40 ? 10 : 5)) + 1 }, (_, i) => -i * (deepest > 40 ? 10 : 5));
---

{view === 'plan' ? (
  <svg class="plan" viewBox={`0 0 ${W} ${H}`} style={`--u:${u}`} role="group" aria-label={`${plan.title}. Select a space for details.`}>
    <defs>
      <pattern id={`dash-${uid}`} width={6 * u} height={6 * u} patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2={6 * u} stroke="#7fa7d9" stroke-width={1.2 * u} />
      </pattern>
    </defs>
    {plan.spaces.map((s) => {
      const r = rect(s.x[0], s.x[1], s.y[0], s.y[1]);
      const [cx, cy] = P(...center(s));
      const a = arrow(s);
      return (
        <g class:list={['space', `space--${s.kind}`, `status--${s.status}`]} data-space={s.id} tabindex="0" role="button" aria-label={`${s.code}: ${s.name}`}>
          <rect class="floor" {...r} fill={s.status === 'uncertain' ? `url(#dash-${uid})` : undefined} />
          {hatch(s).map((l) => <line class="step" {...l} />)}
          {s.pit && <rect class="pit" {...rect(s.pit.x[0], s.pit.x[1], s.pit.y[0], s.pit.y[1])} />}
          {s.decorated.map((w) => <line class="painted" {...wallLine(s, w)} />)}
          {s.pillars.map(([px, py]) => {
            const h = s.pillarSize / 2;
            return <rect class:list={['pillar', { 'pillar--painted': s.decoratedPillars }]} {...rect(px - h, px + h, py - h, py + h)} />;
          })}
          {s.sarcophagus && (
            <rect
              class:list={['sarcophagus', `sarcophagus--${s.sarcophagus.state}`]}
              {...rect(s.sarcophagus.x - s.sarcophagus.w / 2, s.sarcophagus.x + s.sarcophagus.w / 2, s.sarcophagus.y - s.sarcophagus.d / 2, s.sarcophagus.y + s.sarcophagus.d / 2)}
            />
          )}
          {a && <line class="descent" {...a} marker-end={`url(#arrow-${uid})`} />}
          <circle class="code-bg" cx={cx} cy={cy} r={13 * u} />
          <text class="code" x={cx} y={cy} dy={4.5 * u} font-size={12.5 * u}>{s.code}</text>
        </g>
      );
    })}
    <defs>
      <marker id={`arrow-${uid}`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#e9e0c9" />
      </marker>
    </defs>
    <g class="scale" transform={`translate(${M} ${H - M / 2})`}>
      <line x1="0" x2={scaleLen} y1="0" y2="0" />
      <line x1="0" x2="0" y1={-3 * u} y2={3 * u} />
      <line x1={scaleLen} x2={scaleLen} y1={-3 * u} y2={3 * u} />
      <text x={scaleLen + 6 * u} y={4 * u} font-size={11 * u}>{scaleLen} m</text>
    </g>
  </svg>
) : (
  <svg class="profile" viewBox={`0 0 ${PW} ${PH}`} role="group" aria-label={`Depth profile of ${plan.title}. Select a space for details.`}>
    <line class="ground" x1="0" x2={PW} y1={PY(0)} y2={PY(0)} />
    <text class="axis" x={PM} y={PY(0) - 5 * pu} font-size={10 * pu}>Valley floor</text>
    {ticks.slice(1).map((t) => (
      <g class="tick">
        <line x1="0" x2={PW} y1={PY(t)} y2={PY(t)} />
        <text x={PW - PM} y={PY(t) - 3 * pu} font-size={10 * pu} text-anchor="end">{-t} m</text>
      </g>
    ))}
    {segs.map(({ s, x0, x1 }) => {
      const [f0, f1] = s.floor;
      const pts = [[x0, f0], [x1, f1], [x1, f1 + s.height], [x0, f0 + s.height]].map(([x, f]) => `${x + PM},${PY(f)}`).join(' ');
      const mid = (x0 + x1) / 2 + PM;
      return (
        <g class:list={['space', `status--${s.status}`]} data-space={s.id} tabindex="0" role="button" aria-label={`${s.code}: ${s.name}`}>
          <polygon class="volume" points={pts} />
          {s.pit && (
            <rect class="pit" x={x0 + PM + (x1 - x0) * 0.25} y={PY(f0)} width={(x1 - x0) * 0.5} height={s.pit.depth * exaggerate} />
          )}
          {(x1 - x0) / pu > 16 && <text class="code" x={mid} y={PY(Math.max(f0, f1) + s.height) - 6 * pu} font-size={10 * pu}>{s.code}</text>}
        </g>
      );
    })}
  </svg>
)}

<style>
  svg { display: block; width: 100%; height: auto; max-height: 70vh; }
  .space { cursor: pointer; outline: none; }
  .floor { fill: #3a3020; stroke: #a89c80; stroke-width: calc(1px * var(--u)); }
  .space--stairs .floor, .space--corridor .floor { fill: #2f271b; }
  .space--hall .floor, .space--crypt .floor { fill: #463722; }
  .status--uncertain .floor { stroke: #7fa7d9; stroke-dasharray: calc(4px * var(--u)); }
  .step { stroke: rgb(216 203 168 / 0.35); stroke-width: calc(0.8px * var(--u)); }
  .pit { fill: #0d0b09; stroke: #6b5a3c; stroke-width: calc(1px * var(--u)); }
  .painted { stroke: var(--gold); stroke-width: calc(3.5px * var(--u)); stroke-linecap: square; }
  .pillar { fill: #bfa77f; }
  .pillar--painted { fill: var(--gold); }
  .sarcophagus { stroke-width: calc(1.2px * var(--u)); }
  .sarcophagus--in-situ { fill: #9a5a44; stroke: #e9e0c9; }
  .sarcophagus--removed, .sarcophagus--lost { fill: rgb(127 167 217 / 0.2); stroke: #7fa7d9; stroke-dasharray: calc(3px * var(--u)); }
  .descent { stroke: #e9e0c9; stroke-width: calc(1.2px * var(--u)); opacity: 0.6; }
  .code-bg { fill: rgb(11 10 8 / 0.85); stroke: var(--line-strong); stroke-width: calc(1px * var(--u)); }
  .code { fill: var(--limestone); text-anchor: middle; font-family: var(--font-display); font-weight: 600; pointer-events: none; }
  .space:hover .floor, .space:focus-visible .floor { fill: #5a4528; }
  .space.is-active .floor, .space.is-active .volume { fill: rgb(200 149 43 / 0.45); stroke: var(--accent-bright); }
  .space.is-active .code-bg { fill: var(--gold); stroke: var(--gold); }
  .space.is-active .code { fill: var(--basalt); }
  .space:focus-visible .code-bg { stroke: var(--accent-bright); stroke-width: calc(2.5px * var(--u)); }
  .scale line { stroke: var(--limestone); stroke-width: calc(1.5px * var(--u)); }
  .scale text { fill: var(--text-muted); }

  .profile line, .profile polygon, .profile rect { vector-effect: non-scaling-stroke; }
  .profile .ground { stroke: var(--gold); stroke-width: 1.5px; stroke-dasharray: 6 4; }
  .profile .tick line { stroke: rgb(216 203 168 / 0.1); stroke-width: 1px; }
  .profile .tick text, .profile .axis { fill: var(--text-faint); }
  .volume { fill: #3a3020; stroke: #a89c80; stroke-width: 1px; }
  .profile .status--uncertain .volume { fill: rgb(127 167 217 / 0.15); stroke: #7fa7d9; stroke-dasharray: 4 3; }
  .profile .code { font-weight: 600; }
  .profile .space:hover .volume, .profile .space:focus-visible .volume { fill: #5a4528; }
</style>
