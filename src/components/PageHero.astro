---
import { Picture } from 'astro:assets';
import { creditLine, widthsFor, type MediaImage } from '@/lib/media';

export interface Props {
  kicker?: string;
  title: string;
  lede?: string;
  glyph?: string;
  /** Featured image shown full-bleed behind the title (the page's LCP image). */
  image?: MediaImage;
}
const { kicker, title, lede, glyph, image } = Astro.props;
const credit = image && creditLine(image);
---

<section class:list={['hero', { 'hero--image': image }]}>
  {image && (
    <div class="backdrop">
      <Picture
        src={image.src}
        alt={image.alt}
        formats={['avif', 'webp']}
        widths={widthsFor(image.src, [640, 960, 1280, 1920, 2400])}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  )}
  {credit && <span class="hero-credit">{credit}</span>}
  {!image && glyph && <span class="glyph" aria-hidden="true">{glyph}</span>}
  <div class="container">
    <slot name="above" />
    {kicker && <span class="kicker">{kicker}</span>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) clamp(2rem, 1.5rem + 3vw, 4rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 90% at 85% 0%, rgb(31 78 140 / 0.22), transparent 70%),
      radial-gradient(ellipse 50% 80% at 10% 100%, rgb(200 149 43 / 0.12), transparent 70%);
  }
  .glyph {
    position: absolute;
    right: -2rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-glyph);
    font-size: clamp(10rem, 6rem + 18vw, 22rem);
    line-height: 1;
    color: var(--gold);
    opacity: 0.07;
    pointer-events: none;
  }
  h1 { max-width: 20ch; }

  .hero--image {
    min-height: min(78vh, 44rem);
    display: flex;
    align-items: flex-end;
    padding-top: 8rem;
  }
  .hero--image > .container { position: relative; z-index: 1; }
  .backdrop { position: absolute; inset: 0; }
  .backdrop :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  @media (prefers-reduced-motion: no-preference) {
    .backdrop :global(img) { animation: drift 24s var(--ease) both; }
  }
  @keyframes drift { from { transform: scale(1.08); } to { transform: scale(1); } }
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(11 10 8 / 0.35) 0%, rgb(11 10 8 / 0) 30%, rgb(11 10 8 / 0.55) 65%, var(--bg) 100%),
      linear-gradient(90deg, rgb(11 10 8 / 0.7) 0%, rgb(11 10 8 / 0) 60%);
  }
  .hero--image h1 { text-shadow: 0 0.15em 1.2em rgb(0 0 0 / 0.7); }
  .hero--image .lede { color: var(--text); text-shadow: 0 0.1em 0.8em rgb(0 0 0 / 0.8); }
  .hero-credit {
    position: absolute; right: var(--gutter); bottom: 1rem; z-index: 1;
    font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgb(233 224 201 / 0.6);
  }
  @media (max-width: 40rem) { .hero-credit { bottom: auto; top: 5.2rem; } }
</style>
