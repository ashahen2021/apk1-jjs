---
export interface Crumb { label: string; href: string }
export interface Props { items: Crumb[] }
const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ label: 'Home', href: '/' }, ...items].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, Astro.site).href,
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>
        {i === items.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  ol { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0 0 1.5rem; padding: 0; font-size: var(--step--1); }
  li:not(:last-child)::after { content: '›'; margin-left: 0.4rem; color: var(--text-faint); }
  a { color: var(--text-muted); text-decoration: none; }
  a:hover { color: var(--limestone); }
  span { color: var(--text-faint); }
</style>
