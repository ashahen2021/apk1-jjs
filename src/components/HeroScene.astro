---
/**
 * Layered night scene of the Giza plateau, drawn in SVG so it costs no image
 * requests. Layers drift at different speeds on scroll (parallax) unless the
 * visitor prefers reduced motion.
 */

// Deterministic star field so every build renders the same sky.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const stars = Array.from({ length: 140 }, () => ({
  x: Math.round(rand() * 1600),
  y: Math.round(rand() * 520),
  r: (rand() * 1.3 + 0.3).toFixed(2),
  o: (rand() * 0.6 + 0.25).toFixed(2),
  d: (rand() * 4 + 2).toFixed(1),
}));
---

<div class="scene" aria-hidden="true" data-scene>
  <svg class="layer sky" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
    <defs>
      <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#05070d" />
        <stop offset="0.55" stop-color="#0d1526" />
        <stop offset="0.85" stop-color="#2a2016" />
        <stop offset="1" stop-color="#3b2a14" />
      </linearGradient>
      <mask id="crescent">
        <rect width="1600" height="900" fill="#fff" />
        <circle cx="1276" cy="160" r="36" fill="#000" />
      </mask>
      <radialGradient id="moonGlow">
        <stop offset="0" stop-color="#f3e6c0" stop-opacity="0.18" />
        <stop offset="1" stop-color="#f3e6c0" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="1600" height="900" fill="url(#sky)" />
    {stars.map((s) => (
      <circle class="star" cx={s.x} cy={s.y} r={s.r} fill="#f3e6c0" opacity={s.o} style={`animation-duration:${s.d}s`} />
    ))}
    <circle cx="1260" cy="170" r="140" fill="url(#moonGlow)" />
    <circle cx="1260" cy="170" r="38" fill="#efe2bd" mask="url(#crescent)" />
  </svg>

  <svg class="layer far" data-depth="0.15" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
    <defs>
      <linearGradient id="pyrFar" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#3a2d1c" />
        <stop offset="0.5" stop-color="#2a2014" />
        <stop offset="0.5" stop-color="#1a140c" />
        <stop offset="1" stop-color="#140f09" />
      </linearGradient>
    </defs>
    <!-- Menkaure, Khafre, Khufu -->
    <polygon points="250,720 380,610 510,720" fill="url(#pyrFar)" />
    <polygon points="480,720 700,470 920,720" fill="url(#pyrFar)" />
    <polygon points="660,560 700,470 740,560" fill="#4a3a24" opacity="0.5" />
    <polygon points="880,720 1120,440 1360,720" fill="url(#pyrFar)" />
  </svg>

  <svg class="layer mid" data-depth="0.3" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
    <defs>
      <radialGradient id="torch" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#e2b453" stop-opacity="0.55" />
        <stop offset="1" stop-color="#c8952b" stop-opacity="0" />
      </radialGradient>
    </defs>
    <path d="M0 760 C 220 700 420 730 640 740 S 1080 700 1300 730 S 1520 760 1600 740 V 900 H0 Z" fill="#120e09" />
    <circle class="torch" cx="360" cy="742" r="90" fill="url(#torch)" />
    <circle class="torch" cx="1180" cy="734" r="70" fill="url(#torch)" style="animation-delay:-1.3s" />
  </svg>

  <svg class="layer near" data-depth="0.5" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
    <path d="M0 820 C 300 780 560 830 820 810 S 1300 770 1600 800 V 900 H0 Z" fill="#0b0a08" />
  </svg>
</div>

<script>
  const scene = document.querySelector<HTMLElement>('[data-scene]');
  if (scene && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const layers = scene.querySelectorAll<SVGElement>('[data-depth]');
    let ticking = false;
    const update = () => {
      const y = Math.min(window.scrollY, window.innerHeight);
      layers.forEach((l) => (l.style.transform = `translate3d(0, ${y * Number(l.dataset.depth)}px, 0)`));
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) requestAnimationFrame(update);
      ticking = true;
    }, { passive: true });
  }
</script>

<style>
  .scene { position: absolute; inset: 0; overflow: hidden; }
  .layer { position: absolute; inset: 0; width: 100%; height: 100%; will-change: transform; }
  .star { animation: twinkle ease-in-out infinite alternate; }
  .torch { animation: flicker 2.6s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: center; }
  @keyframes twinkle { to { opacity: 0.1; } }
  @keyframes flicker { 50% { opacity: 0.7; transform: scale(0.94); } to { opacity: 1; transform: scale(1.04); } }
</style>
