---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <p class="name">Neo<span>Kemet</span>AI</p>
      <p>{SITE.description}</p>
      <ul class="social" aria-label="NeoKemetAI on social media">
        {SOCIAL.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.label} (opens in a new tab)`} title={s.label}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d={ICONS[s.id]} /></svg>
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--ghost" href={YOUTUBE.subscribeUrl} target="_blank" rel="noopener noreferrer">Subscribe on YouTube</a>
    </div>
    <nav aria-label="Explore">
      <p class="heading">Explore</p>
      <ul class="links">
        {NAV.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        <li><a href="/dynasties/">All dynasties</a></li>
        <li><a href="/monuments/giza-plateau/">Giza Plateau</a></li>
      </ul>
    </nav>
    <nav aria-label="Site information">
      <p class="heading">NeoKemetAI</p>
      <ul class="links">
        {LEGAL_NAV.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        <li><button type="button" class="linklike" data-cookie-settings hidden>Cookie settings</button></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>
      © {year} {SITE.name}. An educational site about ancient Egypt. Dates are approximate before 664 BCE, and
      reconstructions, diagrams and 3D models are interpretations, not photographs: see <a href="/disclaimer/">content accuracy</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: 4rem; border-top: 1px solid var(--line); background: var(--bg-raised); }
  .inner { display: grid; gap: 2.2rem; grid-template-columns: 1fr; padding-block: 3rem; }
  @media (min-width: 40rem) { .inner { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
  @media (min-width: 60rem) { .inner { grid-template-columns: 2fr 1fr 1fr; } .about { grid-column: auto; } }
  .about p { color: var(--text-muted); max-width: 34rem; }
  .name { font-family: var(--font-display); font-size: 1.4rem; letter-spacing: 0.12em; color: var(--limestone) !important; }
  .name span { color: var(--gold); }
  .heading { margin: 0 0 0.9rem; font-family: var(--font-display); font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); }
  ul { list-style: none; margin: 0; padding: 0; }
  .links li { margin-bottom: 0.6rem; }
  .links a { color: var(--text-muted); text-decoration: none; }
  .links a:hover { color: var(--limestone); }
  .linklike { font: inherit; color: var(--text-muted); background: none; border: 0; padding: 0; cursor: pointer; }
  .linklike:hover { color: var(--limestone); }
  .linklike[hidden] { display: none; }
  .social { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.2rem 0 1.4rem; }
  .social a {
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem;
    border: 1px solid var(--line-strong); border-radius: 50%; color: var(--accent-bright);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .social a:hover, .social a:focus-visible { color: var(--basalt); background: var(--gold); border-color: var(--gold); }
  .social svg { fill: currentColor; }
  .legal { border-top: 1px solid var(--line); padding-block: 1.25rem; }
  .legal p { margin: 0; font-size: var(--step--1); color: var(--text-faint); }
  .legal a { color: var(--text-muted); }
</style>
