---
/**
 * Plan of the Giza plateau. Pyramid sizes and positions follow published
 * dimensions and site coordinates; temples, causeways, cemeteries and the
 * workers' town are schematic outlines at approximate positions.
 * Metres from the centre of Khufu's pyramid: x east, z south (north up).
 */
const x0 = -760, x1 = 600, z0 = -330, z1 = 1110;
const W = x1 - x0, H = z1 - z0;
const X = (x: number) => x - x0, Z = (z: number) => z - z0;
const sq = (cx: number, cz: number, w: number, d = w) => ({ x: X(cx - w / 2), y: Z(cz - d / 2), width: w, height: d });
const box = (xa: number, xb: number, za: number, zb: number) => ({ x: X(xa), y: Z(za), width: xb - xa, height: zb - za });
const line = (pts: number[][]) => pts.map(([x, z]) => `${X(x)},${Z(z)}`).join(' ');

const pyramids = [
  { id: 'khufu', name: 'Khufu', sub: 'Great Pyramid', at: [0, 0], w: 230.35, href: '/monuments/great-pyramid/' },
  { id: 'khafre', name: 'Khafre', sub: 'Second Pyramid', at: [-328, 344], w: 215.3, href: '/pharaohs/khafre/' },
  { id: 'menkaure', name: 'Menkaure', sub: 'Third Pyramid', at: [-589, 743], w: 103.4, d: 101.8, href: '/pharaohs/menkaure/' },
];
const queens = [[165, -60], [165, 0], [165, 55]];
const queensM = [[-470, 860], [-540, 860], [-610, 860]];
---

<figure class="plateau-map">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="gpm-t gpm-d">
    <title id="gpm-t">Plan of the Giza plateau</title>
    <desc id="gpm-d">The three pyramids of Khufu, Khafre and Menkaure run diagonally from north-east to south-west, each with a mortuary temple on its east side and a causeway down to a valley temple. The Great Sphinx lies beside Khafre's valley temple. Cemeteries of mastaba tombs flank Khufu's pyramid to the east and west; quarries and the workers' town lie to the south-east.</desc>
    <defs>
      <pattern id="gpm-mastaba" width="16" height="16" patternUnits="userSpaceOnUse">
        <rect width="10" height="6" x="2" y="4" fill="#8a7658" />
      </pattern>
      <pattern id="gpm-quarry" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
        <line x1="0" y1="0" x2="0" y2="10" stroke="#6b5a3c" stroke-width="2" />
      </pattern>
    </defs>
    <rect class="ground" width={W} height={H} />

    <g class="zone approx">
      <rect {...box(40, 280, 520, 780)} fill="url(#gpm-quarry)" />
      <text x={X(160)} y={Z(655)}>Quarries</text>
      <text x={X(160)} y={Z(680)} class="small">(Central Field, approx.)</text>
      <line class="wall" x1={X(260)} x2={X(560)} y1={Z(900)} y2={Z(900)} />
      <text x={X(410)} y={Z(885)} class="small">Wall of the Crow</text>
      <rect {...box(300, 560, 920, 1080)} class="town" />
      <text x={X(430)} y={Z(1005)}>Workers' town</text>
      <text x={X(430)} y={Z(1030)} class="small">(Heit el-Ghurab, approx.)</text>
    </g>

    <g class="cemetery">
      <rect {...box(200, 390, -120, 80)} fill="url(#gpm-mastaba)" />
      <text x={X(295)} y={Z(105)}>Eastern cemetery</text>
      <rect {...box(-370, -150, -260, -60)} fill="url(#gpm-mastaba)" />
      <text x={X(-260)} y={Z(-275)}>Western cemetery</text>
    </g>

    <g class="causeway">
      <polyline points={line([[167, 0], [420, 160]])} class="dashed" />
      <polyline points={line([[-170, 350], [268, 480]])} />
      <polyline points={line([[-495, 745], [-40, 950]])} class="dashed" />
    </g>

    <g class="temple">
      <rect {...box(115, 167, -26, 26)} />
      <rect {...box(-220, -170, 318, 370)} />
      <rect {...box(268, 313, 462, 507)} />
      <rect {...box(372, 418, 412, 458)} />
      <rect {...box(-537, -495, 718, 768)} />
      <rect {...box(-80, -20, 925, 985)} class="approx-temple" />
    </g>

    <g class="boats">
      <rect {...box(-60, -15, 132, 138)} />
      <rect {...box(15, 60, 132, 138)} />
      <rect {...box(122, 128, -80, -35)} />
      <rect {...box(122, 128, 35, 80)} />
    </g>

    {pyramids.map((p) => (
      <a href={p.href} class="pyr">
        <rect {...sq(p.at[0], p.at[1], p.w, p.d ?? p.w)} />
        <line x1={X(p.at[0] - p.w / 2)} y1={Z(p.at[1] - (p.d ?? p.w) / 2)} x2={X(p.at[0] + p.w / 2)} y2={Z(p.at[1] + (p.d ?? p.w) / 2)} />
        <line x1={X(p.at[0] + p.w / 2)} y1={Z(p.at[1] - (p.d ?? p.w) / 2)} x2={X(p.at[0] - p.w / 2)} y2={Z(p.at[1] + (p.d ?? p.w) / 2)} />
        <text x={X(p.at[0])} y={Z(p.at[1]) + (p.w > 150 ? 12 : -60)} class="name">{p.name}</text>
      </a>
    ))}
    {[...queens.map((q) => [q, 46]), ...queensM.map((q) => [q, 36])].map(([q, w]) => (
      <rect {...sq((q as number[])[0], (q as number[])[1], w as number)} class="queen" />
    ))}

    <a href="/monuments/great-sphinx/" class="sphinx">
      <rect {...box(292, 365, 425, 444)} />
      <text x={X(328)} y={Z(410)} class="name small-name">Sphinx</text>
    </a>

    <g class="legend-labels">
      <text x={X(141)} y={Z(-95)} class="small" text-anchor="middle">Mortuary temple</text>
      <line class="lead" x1={X(141)} y1={Z(-90)} x2={X(141)} y2={Z(-28)} />
      <text x={X(0)} y={Z(160)} class="small" text-anchor="middle">Boat pits (approx.)</text>
      <text x={X(60)} y={Z(420)} class="small">Khafre's causeway</text>
      <text x={X(290)} y={Z(530)} class="small" text-anchor="middle">Valley temple</text>
      <text x={X(395)} y={Z(475)} class="small" text-anchor="middle">Sphinx temple</text>
      <text x={X(-50)} y={Z(1005)} class="small" text-anchor="middle">Menkaure valley temple (approx.)</text>
    </g>

    <g class="north" transform={`translate(${X(520)} ${Z(-270)})`}>
      <path d="M0,-30 L10,5 L0,-2 L-10,5 Z" />
      <text y="24" text-anchor="middle">N</text>
    </g>
    <g class="scale" transform={`translate(${X(-730)} ${Z(1080)})`}>
      <line x1="0" x2="200" y1="0" y2="0" />
      <line x1="0" x2="0" y1="-6" y2="6" />
      <line x1="200" x2="200" y1="-6" y2="6" />
      <text x="100" y="-10" text-anchor="middle">200 m</text>
    </g>
  </svg>
  <figcaption>Pyramids to scale at positions derived from site coordinates. Temples, causeways, boat pits and cemeteries are schematic outlines; the quarries, Menkaure's valley temple and the workers' town are shown at approximate positions. Dashed causeways are only partly traced. Select a pyramid or the Sphinx to open its page.</figcaption>
</figure>

<style>
  .plateau-map { margin: 0; }
  svg { display: block; width: 100%; height: auto; max-height: 80vh; border: 1px solid var(--line-strong); border-radius: var(--radius); }
  .ground { fill: #2a2217; }
  text { fill: #e9e0c8; font: 22px var(--font-body); text-anchor: middle; }
  .small { font-size: 16px; fill: #bfb297; }
  .pyr rect { fill: #cdb893; stroke: #f0dcab; stroke-width: 2; }
  .pyr line { stroke: #8f7c59; stroke-width: 1.5; }
  .pyr:hover rect, .pyr:focus-visible rect { fill: #f0b73a; }
  .name { font-weight: 700; font-size: 26px; paint-order: stroke; stroke: #2a2217; stroke-width: 6px; }
  .small-name { font-size: 20px; }
  .queen { fill: #b9a47d; stroke: #e9d9b4; stroke-width: 1.5; }
  .temple rect { fill: #9f8a64; stroke: #d8c79f; stroke-width: 1.5; }
  .temple .approx-temple { stroke-dasharray: 6 4; fill: none; }
  .causeway polyline { fill: none; stroke: #d8c79f; stroke-width: 7; stroke-linecap: round; }
  .causeway .dashed { stroke-dasharray: 16 10; }
  .boats rect { fill: #14100b; stroke: #6b5a3c; }
  .sphinx rect { fill: #f0b73a; stroke: #fff2cc; stroke-width: 2; }
  .cemetery rect { stroke: #8a7658; stroke-width: 1.5; }
  .zone .town { fill: none; stroke: #bfb297; stroke-width: 2; stroke-dasharray: 8 6; }
  .zone .wall { stroke: #bfb297; stroke-width: 6; }
  .lead { stroke: #bfb297; stroke-width: 1.5; }
  .north path { fill: #f0b73a; }
  .north text { font-weight: 700; }
  .scale line { stroke: #e9e0c8; stroke-width: 3; }
  figcaption { margin-top: 0.6rem; font-size: 0.8rem; color: var(--text-muted); max-width: 80ch; }
</style>
