---
/**
 * Hub sections for the Giza Plateau: layout overview, plan and complex
 * diagrams, a schematic 3D plateau model, the 4th Dynasty timeline and links
 * into the rest of the cluster.
 */
import { getEntry } from 'astro:content';
import { statSync } from 'node:fs';
import type { ImageMetadata } from 'astro';
import MediaSection from '@/components/media/MediaSection.astro';
import GizaModel from '@/components/media/GizaModel.astro';
import Card from '@/components/Card.astro';
import PlateauMap from './PlateauMap.astro';
import PyramidComplex from './PyramidComplex.astro';
import GizaTimeline from './GizaTimeline.astro';
import Cite from './Cite.astro';
import References from './References.astro';
import { cards } from '@/lib/cards';
import { videosAbout } from '@/lib/content';
import { PLATEAU_MAT, PLATEAU_MODES, PLATEAU_PARTS, PLATEAU_SCALE, PLATEAU_SITES, plateauPos } from '@/lib/structures';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/media/monuments/giza-plateau/model-*.png', { eager: true });
const posters = Object.fromEntries(PLATEAU_MODES.map((m) => [m.id, images[`/src/assets/media/monuments/giza-plateau/model-${m.id}.png`].default]));
const materials = Object.fromEntries(PLATEAU_MODES.map((m) => [m.id, PLATEAU_PARTS[m.id].map((p) => PLATEAU_MAT[p])]));
const r = (1500 * PLATEAU_SCALE).toFixed(3);
const orbits = Object.fromEntries(PLATEAU_MODES.map((m) => [m.id, { orbit: `${m.camera[0]}deg ${m.camera[1]}deg ${r}m`, target: plateauPos([-150, 20, 380]) }]));
const spots = PLATEAU_SITES.map((s, i) => ({ id: s.id, label: String(i + 1), title: s.title, status: 'approximate' as const, position: plateauPos(s.at), href: 'href' in s ? s.href : undefined, material: PLATEAU_MAT.temples }));
const sizeKB = Math.round(statSync(new URL('../../../public/models/giza-plateau.glb', import.meta.url)).size / 1024);

const [gp, sphinx, khufu, khafre, menkaure] = await Promise.all([
  getEntry('monuments', 'great-pyramid'), getEntry('monuments', 'great-sphinx'),
  getEntry('pharaohs', 'khufu'), getEntry('pharaohs', 'khafre'), getEntry('pharaohs', 'menkaure'),
]);
const videos = (await videosAbout('monuments', 'great-pyramid')).slice(0, 3);
const refs = ['wpGiza', 'wp4', 'wpKhafre', 'wpMenkaure', 'wpSphinx', 'aera', 'moa', 'lehnerLabor', 'sheisha', 'wpMerer', 'lehnerHawass', 'lehner97', 'tallet', 'unesco'];
---

<MediaSection id="overview" kicker="Site overview" title="How the plateau is laid out">
  <div class="prose">
    <p>The Giza plateau is a limestone ridge on the west bank of the Nile, at the edge of the desert above the floodplain. Three kings of the 4th Dynasty built here: Khufu, his son Khafre and Khafre's son Menkaure. Their pyramids stand on a rough diagonal from north-east to south-west, each smaller than the last. <Cite ids={['wpGiza', 'wp4']} /></p>
    <p>Each pyramid was the centre of a complex. A mortuary temple for the king's cult stood against its east face, and a causeway ran down to a valley temple near the floodplain; Nile waterways reached the foot of the plateau. Smaller queens' pyramids and boat pits lay beside the king's pyramid. <Cite ids={['wpGiza', 'sheisha']} /></p>
    <p>Around Khufu's pyramid lie cemeteries of mastaba tombs: members of the royal family to the east, officials to the west. The Great Sphinx lies beside Khafre's valley temple, carved from the bedrock. <Cite ids={['wpGiza', 'wpSphinx']} /> South-east of the plateau, beyond a massive stone wall, archaeologists have excavated the town where the builders lived and the cemetery of its workers and overseers. <Cite ids={['lehnerLabor', 'aera', 'moa']} /></p>
  </div>
</MediaSection>

<MediaSection id="plan" kicker="Map" title="Plan of the plateau" lede="Pyramids to scale; temples, causeways and cemeteries schematic. Select a pyramid or the Sphinx.">
  <PlateauMap />
  <h3 class="sub">Anatomy of a pyramid complex</h3>
  <PyramidComplex />
</MediaSection>

<MediaSection id="plateau-3d" kicker="Interactive model" title="The plateau in 3D" lede="A simplified model of the plateau. Compare the pyramids as built with how they stand today; numbered markers link to their pages.">
  <GizaModel
    id="plateau-model"
    src="/models/giza-plateau.glb"
    alt="Simplified 3D model of the Giza plateau with the three pyramids, queens' pyramids, temples, causeways, the Sphinx and the mastaba cemeteries."
    modes={PLATEAU_MODES}
    materials={materials}
    posters={posters}
    orbits={orbits}
    spots={spots}
    sizeKB={sizeKB}
    caption="Schematic NeoKemetAI model at 1:1000. The three main pyramids follow published base sizes; their positions and everything else (queens' pyramids, temples, causeways, cemeteries, the Sphinx) are indicative placements by us, not surveyed."
  />
</MediaSection>

<MediaSection id="timeline" kicker="Old Kingdom" title="Giza in the 4th Dynasty" lede="The plateau was built in about three generations, in the 26th and 25th centuries BCE.">
  <GizaTimeline />
</MediaSection>

<MediaSection id="explore" kicker="Explore the plateau" title="Monuments, kings and films">
  <div class="grid">
    {gp && <Card {...cards.monument(gp)} headingLevel="h3" />}
    {sphinx && <Card {...cards.monument(sphinx)} headingLevel="h3" />}
    {khufu && <Card {...cards.pharaoh(khufu)} headingLevel="h3" />}
    {khafre && <Card {...cards.pharaoh(khafre)} headingLevel="h3" />}
    {menkaure && <Card {...cards.pharaoh(menkaure)} headingLevel="h3" />}
    {videos.map((v) => <Card {...cards.video(v)} headingLevel="h3" />)}
  </div>
  <p class="more">Later royal tombs: <a href="/tombs/">the tombs of the Valley of the Kings and the Valley of the Queens</a>. The Giza mastaba cemeteries, boat pits and temples will get their own pages.</p>
</MediaSection>

<References ids={refs}>
  <h3 class="assume">Reconstruction assumptions</h3>
  <ul class="assume-list">
    <li>The plan and the 3D plateau model draw the three main pyramids at their published base sizes. Their relative positions, and the positions and shapes of the temples, causeways, boat pits, cemeteries, quarries, the Sphinx and the workers' town, are indicative placements by us, not traced from a survey plan.</li>
    <li>The "as built" view shows every pyramid fully cased; the "today" view simplifies the stepped cores and the surviving casing.</li>
    <li>The pyramid-complex diagram is generic and does not reproduce any one complex.</li>
  </ul>
</References>

<style>
  .prose { max-width: 75ch; color: var(--text-muted); }
  .assume { font-size: var(--step-0); margin: 1.4rem 0 0.4rem; }
  .assume-list { padding-left: 1.2rem; display: grid; gap: 0.4rem; max-width: 85ch; font-size: var(--step--1); color: var(--text-muted); }
  .sub { margin: 2.2rem 0 1rem; font-size: var(--step-1); }
  .grid { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .more { margin-top: 1.5rem; color: var(--text-muted); }
</style>
